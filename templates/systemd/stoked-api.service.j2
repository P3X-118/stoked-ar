[Unit]
Description=Stoked API ({{ stoked_api_identifier }})
{% for service in stoked_api_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in stoked_api_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ stoked_api_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ stoked_api_identifier }} 2>/dev/null || true'

ExecStartPre={{ sysd_docker_host_command }} create \
                --rm \
                --name={{ stoked_api_identifier }} \
                --log-driver=none \
                --network={{ stoked_api_container_network }} \
                --env-file={{ stoked_api_base_path }}/env \
                --label-file={{ stoked_api_base_path }}/labels \
                --mount type=bind,src={{ stoked_base_path }}/Revolt.toml,dst=/Revolt.toml,options=ro \
                {% if stoked_api_container_extra_arguments | length > 0 %}
                {{ stoked_api_container_extra_arguments | join(' ') }} \
                {% endif %}
                {{ stoked_api_container_image }}

{% for network in stoked_api_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ stoked_api_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ stoked_api_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ stoked_api_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ stoked_api_identifier }} 2>/dev/null || true'
Restart=always
RestartSec=30
SyslogIdentifier={{ stoked_api_identifier }}

[Install]
WantedBy=multi-user.target
