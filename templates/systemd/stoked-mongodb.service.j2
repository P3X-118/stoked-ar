[Unit]
Description=Stoked MongoDB ({{ stoked_mongodb_identifier }})
{% for service in stoked_mongodb_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ stoked_mongodb_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ stoked_mongodb_identifier }} 2>/dev/null || true'

ExecStartPre={{ sysd_docker_host_command }} create \
                --rm \
                --name={{ stoked_mongodb_identifier }} \
                --log-driver=none \
                --network={{ stoked_mongodb_container_network }} \
                --mount type=bind,src={{ stoked_mongodb_data_path }},dst=/data/db \
                {{ stoked_mongodb_container_image }}

ExecStart={{ sysd_docker_host_command }} start --attach {{ stoked_mongodb_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ stoked_mongodb_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ stoked_mongodb_identifier }} 2>/dev/null || true'
Restart=always
RestartSec=30
SyslogIdentifier={{ stoked_mongodb_identifier }}

[Install]
WantedBy=multi-user.target
