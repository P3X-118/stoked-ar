{% if stoked_api_container_labels_traefik_enabled %}
traefik.enable=true

{% if stoked_api_container_labels_traefik_docker_network %}
traefik.docker.network={{ stoked_api_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if stoked_api_container_labels_traefik_compression_middleware_enabled %}
{% set middlewares = middlewares + [stoked_api_container_labels_traefik_compression_middleware_name] %}
{% endif %}

{% if stoked_api_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ stoked_api_identifier }}-slashless-redirect.redirectregex.regex=({{ stoked_api_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ stoked_api_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [stoked_api_identifier + '-slashless-redirect'] %}
{% endif %}

{% if stoked_api_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ stoked_api_identifier }}-strip-prefix.stripprefix.prefixes={{ stoked_api_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [stoked_api_identifier + '-strip-prefix'] %}
{% endif %}

{% if stoked_api_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in stoked_api_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ stoked_api_identifier }}-add-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [stoked_api_identifier + '-add-headers'] %}
{% endif %}

traefik.http.routers.{{ stoked_api_identifier }}.rule={{ stoked_api_container_labels_traefik_rule }}
{% if stoked_api_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ stoked_api_identifier }}.priority={{ stoked_api_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ stoked_api_identifier }}.service={{ stoked_api_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ stoked_api_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ stoked_api_identifier }}.entrypoints={{ stoked_api_container_labels_traefik_entrypoints }}

traefik.http.routers.{{ stoked_api_identifier }}.tls={{ stoked_api_container_labels_traefik_tls | to_json }}
{% if stoked_api_container_labels_traefik_tls %}
traefik.http.routers.{{ stoked_api_identifier }}.tls.certResolver={{ stoked_api_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ stoked_api_identifier }}.loadbalancer.server.port={{ stoked_api_http_port }}
{% endif %}

{% for arg in stoked_api_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
